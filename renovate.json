{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Database images: only propose an update 30 days after its release",
      "matchDepNames": [
        "postgres",
        "mariadb"
      ],
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "Database majors (CI test images) need a human: a new major needs a data migration in the add-on",
      "matchDepNames": [
        "postgres",
        "mariadb"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "database-major"
      ]
    },
    {
      "description": "HA base image: tag is <alpine>-<year>.<month>.<n>; stay on the same Alpine release (it decides the database packages)",
      "matchDepNames": [
        "ghcr.io/home-assistant/base"
      ],
      "versioning": "regex:^(?<compatibility>\\d+\\.\\d+)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "labels": [
        "rebuild-addon"
      ]
    }
  ]
}
